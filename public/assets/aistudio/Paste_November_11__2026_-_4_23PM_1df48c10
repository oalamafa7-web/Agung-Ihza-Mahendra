  const msg=del.length===1?`Hapus sesi Line ${del[0].line} (${fmtD(del[0].date)})?\nSemua checklist sesi ini ikut terhapus.`
    :`Hapus ${del.length} sesi terpilih?\nSemua checklist sesi tersebut ikut terhapus.`;
