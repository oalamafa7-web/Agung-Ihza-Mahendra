/* ================= PARSING EXCEL ================= */
const COLS={dt:['dt','date','tanggal'],line:['line'],file:['file','fileno'],style:['style','styleno'],seq:['seq'],process:['process','proses'],
  machine:['machine','mesin'],counter:['counter','counterno'],mc:['machinecode'],uid:['userid','nik'],name:['username','nama','operator'],
  target:['targetqty','target'],actual:['actualqty','actual','output'],avg:['avgqty','avg'],wt:['worktime']};
function findHeader(rows){for(let i=0;i<Math.min(rows.length,30);i++){const n=(rows[i]||[]).map(norm);if(n.includes('process')&&n.includes('username'))return i}return -1}
function parseDB(rows,h,sn,fn){
  const H=rows[h],idx={};
  H.forEach((c,i)=>{const n=norm(c);for(const k in COLS)if(idx[k]===undefined&&COLS[k].includes(n))idx[k]=i});
  const used=Object.values(idx),hourCols=[];
  H.forEach((c,i)=>{const s=String(c);if(/\d{1,2}[:.]\d{2}/.test(s)&&!used.includes(i))hourCols.push({i,l:s.replace(/\s*\n\s*/g,'-').replace(/\s*~\s*/g,'-')})});
  const ops=[],first={};
  for(let r=h+1;r<rows.length;r++){
    const R=rows[r]||[],g=k=>idx[k]===undefined?'':(R[idx[k]]??'');
    ['dt','line','file','style'].forEach(k=>{const v=g(k);if(first[k]===undefined&&v!=='')first[k]=v});
    const process=String(g('process')).trim(),name=String(g('name')).trim();
    if(!process||!name)continue;
    ops.push({seq:String(g('seq')).trim(),process,machine:String(g('machine')).trim(),counter:String(g('counter')).trim(),mc:String(g('mc')).trim(),
      uid:String(g('uid')).trim(),name,target:num(g('target')),actual:num(g('actual')),avg:num(g('avg')),wt:num(g('wt')),h:hourCols.map(c=>num(R[c.i]))});
  }
  const keep=hourCols.map((c,j)=>ops.some(o=>o.h[j]!==null));
  ops.forEach(o=>o.h=o.h.filter((_,j)=>keep[j]));
  let line=String(first.line||'').trim();
  if(!line){const c=ops.find(o=>/^[\w]+-/.test(o.counter));line=c?c.counter.split('-')[0]:sn.trim()}
  return {id:'s'+Date.now()+Math.random().toString(36).slice(2,7),line,date:toYMD(first.dt),file:String(first.file||'').trim(),
    style:String(first.style||'').trim(),fileName:fn,sheet:sn.trim(),ops,hours:hourCols.filter((_,j)=>keep[j]).map(c=>c.l),
    tpl:guessTpl(sn,[...new Set(ops.map(o=>o.process))]),map:{},checks:{},bdate:{},created:Date.now()};
}
function parseSOP(rows){
  const blocks=[],map={};
  for(let r=0;r<rows.length;r++){const row=rows[r]||[];
    for(let c=0;c<row.length-2;c++){
      if(String(row[c]).trim()==='No.'&&String(row[c+2]).trim().toUpperCase()==='PIC'&&String(row[c+1]).trim()){
        const b={t:cleanT(row[c+1]),m:'',i:[],_raw:String(row[c+1]).trim()};let k=r+1;
        while(k<rows.length){const x=rows[k]||[],no=x[c];if(no===''||no==null||isNaN(Number(no)))break;
          b.i.push([String(x[c+1]??'').replace(/\s*\n\s*/g,' ').trim(),String(x[c+2]??'').trim()]);k++}
        if(b.i.length)blocks.push(b);break;
      }
      if(/^proses di/i.test(String(row[c]).trim())&&/^proses di/i.test(String(row[c+1]).trim())){
        for(let k=r+1;k<rows.length;k++){const a=String((rows[k]||[])[c]??'').trim();if(!a)break;map[norm(a)]=String(rows[k][c+1]??'').trim()}
      }
    }
  }
  blocks.forEach(b=>{b.m=map[norm(b._raw)]||'';delete b._raw});
  return blocks;
}
function guessTpl(sheetName,P){
  const sn=norm(sheetName),PN=P.map(norm);let best='',score=-1;
  templates.forEach(t=>{let sc=0;if(norm(t.name)&&sn.includes(norm(t.name)))sc+=100;
    t.blocks.forEach(b=>{if(b.m&&PN.includes(norm(b.m)))sc+=2;else if(autoMatch(b.t,P))sc+=1});
    if(sc>score){score=sc;best=t.key}});
  return best;
}
function upsertTpl(name,blocks){
  const ex=templates.find(t=>norm(t.name)===norm(name));
  if(ex){ex.blocks=blocks}else templates.push({key:'tpl_'+norm(name)+'_'+Date.now(),name,blocks});
}
function addSession(s){
  const dup=sessions.find(x=>x.line===s.line&&x.file===s.file&&x.date===s.date&&x.tpl===s.tpl);
  if(dup){if(confirm(`Sesi Line ${s.line} (${fmtD(s.date)}) sudah ada.\nUpdate data operator? Checklist yang sudah diisi tetap disimpan.`)){dup.ops=s.ops;dup.hours=s.hours;dup.fileName=s.fileName;return 1}return 0}
  sessions.unshift(s);return 1;
}
async function handleFiles(files){
  let ns=0,nt=0;
  for(const f of files){
    try{
      const wb=XLSX.read(await f.arrayBuffer(),{type:'array'});
      const sheets=wb.SheetNames.map(sn=>({sn,rows:XLSX.utils.sheet_to_json(wb.Sheets[sn],{header:1,defval:'',raw:true})}));
      sheets.forEach(({sn,rows})=>{if(findHeader(rows)>=0)return;const b=parseSOP(rows);if(b.length){upsertTpl(sn.trim(),b);nt++}});
      sheets.forEach(({sn,rows})=>{const h=findHeader(rows);if(h<0)return;const s=parseDB(rows,h,sn,f.name);if(s.ops.length)ns+=addSession(s)});
    }catch(err){console.error(err);toast('❌ Gagal membaca '+f.name)}
  }
  save();render();toast(`✅ ${ns} sesi ditambahkan/diupdate • ${nt} template SOP diperbarui`);
}

