/* ================= VIEW: TEMPLATE ================= */
function viewTpl(){
  return `<div class="shead"><button class="btn" data-act="home">← Sesi</button><div class="stitle"><h2>📚 Template SOP</h2></div>
  <button class="btn" data-act="tplreset">↺ Reset template bawaan</button><button class="btn primary" data-act="upload">⬆️ Import dari Excel</button></div>
  <div class="info">Format sheet SOP: baris judul <b>No. | Nama Proses | PIC</b>, lalu baris check point bernomor 1, 2, 3... (seperti sheet T-Shirt / Legging). Mapping opsional: kolom berjudul "Proses di ..." | "Proses di Database". Nama sheet = nama template (contoh "Polo", "Jogger").</div>
  ${templates.map(t=>`<div class="card"><div class="row sb wrap"><div><h3>${esc(t.name)} ${t.builtin?'<span class="badge">bawaan</span>':''}</h3>
  <div class="meta">${t.blocks.length} proses · ${t.blocks.reduce((a,b)=>a+b.i.length,0)} check point · dipakai ${sessions.filter(s=>s.tpl===t.key).length} sesi</div></div>
  <div class="row"><button class="btn" data-act="tplview" data-k="${esc(t.key)}">${state.tplOpen===t.key?'Tutup':'Lihat'}</button><button class="btn danger" data-act="tpldel" data-k="${esc(t.key)}">Hapus</button></div></div>
  ${state.tplOpen===t.key?t.blocks.map((b,bi)=>`<div style="margin-top:12px"><b>${bi+1}. ${esc(b.t)}</b> <small class="meta">→ ${esc(b.m||'(auto)')}</small><ol style="margin:6px 0">${b.i.map(([x,p])=>`<li>${esc(x)} <span class="pic pic-${norm(p)}">${esc(p)}</span></li>`).join('')}</ol></div>`).join(''):''}</div>`).join('')}`;
}

/* ================= EXPORT / BACKUP ================= */
function exportXlsx(s){
  const st=stats(s),t=tplOf(s),A=st.active,ops=sopOps(s,st),wb=XLSX.utils.book_new();
  const sum=[['PERFORMANCE ASSESSMENT SOP'],[],['Line',s.line],['Produk',t.name],['Tanggal',fmtD(s.date)],['File#',s.file],['Style#',s.style],[],
    ['Total Operator',st.opCount],['Proses SOP',st.procCount],['Total Check Point',st.total],['Sudah ☑',st.done],['Belum ☐',st.pending],['% Compliance',pctTxt(st.pct)],[],
    ['Proses SOP','Proses Database','Tgl Mulai','Operator','Check Point','Sudah','% Compliance'],
    ...A.map(x=>[cleanT(x.b.t),x.p,(s.bdate||{})[x.bi]||'',x.ops.length,x.tot,x.done,pctTxt(x.pct)])];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(sum),'Summary');
  const ck=[];A.forEach(x=>{ck.push([`${x.bi+1}. ${cleanT(x.b.t)}`,'Tgl Mulai: '+((s.bdate||{})[x.bi]||'-')]);ck.push(['No.','Check Point','PIC',...x.ops]);
    x.b.i.forEach(([tx,p],ii)=>ck.push([ii+1,tx,p,...x.ops.map(n=>s.checks[key(x.bi,ii,n)]?'☑':'☐')]));ck.push([])});
  const wsC=XLSX.utils.aoa_to_sheet(ck);wsC['!cols']=[{wch:5},{wch:60},{wch:9}];XLSX.utils.book_append_sheet(wb,wsC,'Checklist');
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([['Operator','Proses','Sudah','Total','% Compliance'],...st.per.map(o=>[o.name,o.proc.join(', '),o.done,o.tot,pctTxt(o.done/o.tot)])]),'Operator');
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([['Seq','Process','Machine','Counter#','Machine Code','User ID','User Name','Target Qty','Actual Qty','Avg Qty','Work Time',...(s.hours||[])],
    ...ops.map(o=>[o.seq,o.process,o.machine,o.counter,o.mc,o.uid,o.name,o.target,o.actual,o.avg,o.wt,...o.h])]),'Database');
  XLSX.writeFile(wb,`Assessment_${s.line}_${t.name}_${s.date||'nodate'}.xlsx`);
}

/* ================= EVENT ================= */
function render(){
  const app=$('#app');
  if(state.view==='session'&&cur())app.innerHTML=viewSession();
  else if(state.view==='tpl')app.innerHTML=viewTpl();
  else{state.view='home';app.innerHTML=viewHome()}
}
function refresh(){const y=scrollY,sl={};document.querySelectorAll('.tw[data-bi]').forEach(e=>sl[e.dataset.bi]=e.scrollLeft);render();
  document.querySelectorAll('.tw[data-bi]').forEach(e=>e.scrollLeft=sl[e.dataset.bi]||0);scrollTo(0,y)}
function setMany(ks){const s=cur(),all=ks.every(k=>s.checks[k]);ks.forEach(k=>{if(all)delete s.checks[k];else s.checks[k]=1});save();refresh()}
const ACT={
  upload:()=>$('#file').click(),
  open:d=>{
    if(state.selMode){const i=state.sel.indexOf(d.id);if(i>=0)state.sel.splice(i,1);else state.sel.push(d.id);$('#list').innerHTML=listHtml();return}
    state.sid=d.id;state.view='session';state.tab='dash';state.showAll=false;render();scrollTo(0,0)},
  del:d=>deleteSessions([d.id]),
  delcur:()=>deleteSessions([state.sid]),
  selmode:()=>{state.selMode=!state.selMode;state.sel=[];render()},
  selall:()=>{const ids=filtered().map(x=>x.s.id);state.sel=ids.every(id=>state.sel.includes(id))?[]:ids;$('#list').innerHTML=listHtml()},
  delsel:()=>deleteSessions([...state.sel]),
  undo:()=>{if(!trash.length)return;sessions.push(...trash);const n=trash.length;trash=[];save();render();$('#toast').classList.remove('show');setTimeout(()=>toast(`↩️ ${n} sesi dikembalikan`),300)},
  home:()=>{state.view='home';state.selMode=false;state.sel=[];render();scrollTo(0,0)},
  tab:d=>{state.tab=d.k;render();scrollTo(0,0)},
  gocheck:d=>{state.tab='check';render();setTimeout(()=>ACT.jump(d),50)},
  tog:d=>{const s=cur(),k=key(d.bi,d.ii,d.n);if(s.checks[k])delete s.checks[k];else s.checks[k]=1;save();refresh()},
  opall:d=>setMany(tplOf(cur()).blocks[d.bi].i.map((_,ii)=>key(d.bi,ii,d.n))),
  rowall:d=>setMany(stats(cur()).blocks[d.bi].ops.map(n=>key(d.bi,d.ii,n))),
  jump:d=>{const el=document.getElementById('blk-'+d.bi);if(el)scrollTo({top:el.getBoundingClientRect().top+scrollY-130,behavior:'smooth'})},
  resetck:()=>{if(confirm('Reset semua centang di sesi ini?')){cur().checks={};save();refresh()}},
  showall:()=>{state.showAll=!state.showAll;refresh()},
  export:()=>exportXlsx(cur()),
  tpl:()=>{state.view='tpl';state.selMode=false;state.sel=[];render();scrollTo(0,0)},
  tplview:d=>{state.tplOpen=state.tplOpen===d.k?null:d.k;render()},
  tpldel:d=>{const n=sessions.filter(s=>s.tpl===d.k).length;if(confirm(`Hapus template ini?${n?`\n⚠️ ${n} sesi memakai template ini.`:''}`)){templates=templates.filter(t=>t.key!==d.k);save();render()}},
  tplreset:()=>{if(!confirm('Kembalikan template T-Shirt & Legging ke versi bawaan?'))return;
    BUILTIN.forEach(b=>{const i=templates.findIndex(t=>norm(t.name)===norm(b.name));const c=clone(b);if(i>=0)templates[i]={...c,key:templates[i].key};else templates.push(c)});save();render()},
  backup:()=>{download(`Backup_SOP_Assessment_${new Date().toISOString().slice(0,10)}.json`,new Blob([JSON.stringify({v:1,sessions,templates})],{type:'application/json'}));toast('💾 Backup diunduh')},
  restore:()=>$('#backupFile').click()
};
const CHG={
  fprod:el=>{state.fprod=el.value;$('#list').innerHTML=listHtml()},
  sort:el=>{state.sort=el.value;$('#list').innerHTML=listHtml()},
  sdate:el=>{cur().date=el.value;save()},
  stpl:el=>{const s=cur();if(Object.keys(s.checks).length&&!confirm('Ganti template SOP akan mereset checklist sesi ini. Lanjut?')){el.value=s.tpl;return}
    s.tpl=el.value;s.map={};s.checks={};s.bdate={};save();render()},
  map:el=>{const s=cur(),bi=el.dataset.bi;s.map=s.map||{};s.map[bi]=el.value;
    Object.keys(s.checks).forEach(k=>{if(k.startsWith(bi+'|'))delete s.checks[k]});save();refresh()},
  bdate:el=>{const s=cur();s.bdate=s.bdate||{};s.bdate[el.dataset.bi]=el.value;save()}
};
document.addEventListener('click',e=>{const el=e.target.closest('[data-act]');if(!el||el.disabled)return;e.stopPropagation();ACT[el.dataset.act]&&ACT[el.dataset.act](el.dataset,el,e)});
document.addEventListener('change',e=>{const el=e.target.closest('[data-chg]');if(el&&CHG[el.dataset.chg])CHG[el.dataset.chg](el)});
document.addEventListener('input',e=>{
  if(e.target.id==='q'){state.q=e.target.value;$('#list').innerHTML=listHtml()}
  if(e.target.id==='dq'){const q=e.target.value.toLowerCase();document.querySelectorAll('#dtbl tbody tr').forEach(tr=>tr.style.display=tr.textContent.toLowerCase().includes(q)?'':'none')}
});
$('#file').addEventListener('change',e=>{if(e.target.files.length)handleFiles([...e.target.files]);e.target.value=''});
$('#backupFile').addEventListener('change',async e=>{
  const f=e.target.files[0];e.target.value='';if(!f)return;
  try{const d=JSON.parse(await f.text());let n=0;
    (d.templates||[]).forEach(t=>{const i=templates.findIndex(x=>x.key===t.key);if(i>=0)templates[i]=t;else templates.push(t)});
    (d.sessions||[]).forEach(s=>{const i=sessions.findIndex(x=>x.id===s.id);if(i>=0)sessions[i]=s;else sessions.push(s);n++});
    save();render();toast(`♻️ ${n} sesi dipulihkan`)}catch(err){toast('❌ File backup tidak valid')}
});
setInterval(()=>{$('#clock').textContent=new Date().toLocaleString('id-ID',{weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})},1000);
render();
</script>
</body>
</html>