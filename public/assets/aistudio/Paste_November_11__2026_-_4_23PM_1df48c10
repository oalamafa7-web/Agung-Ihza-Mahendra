<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1e3a8a">
<title>Performance Assessment SOP</title>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<style>
:root{--bg:#f1f5f9;--card:#fff;--pri:#1e40af;--pri2:#3b82f6;--txt:#0f172a;--mut:#64748b;--g:#16a34a;--y:#eab308;--r:#dc2626;--bd:#e2e8f0}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--txt);font-size:16px}
header.top{position:sticky;top:0;z-index:30;height:60px;background:linear-gradient(90deg,#1e3a8a,#2563eb);color:#fff;padding:0 18px;display:flex;align-items:center;justify-content:space-between}
header.top b{font-size:18px}
main{padding:16px;max-width:1400px;margin:auto}
.btn{border:1px solid var(--bd);background:#fff;color:var(--txt);border-radius:12px;padding:10px 16px;font-size:16px;font-weight:600;min-height:48px;cursor:pointer}
.btn.primary{background:var(--pri);color:#fff;border-color:var(--pri)}
.btn.danger{color:var(--r)}
.btn.red{background:var(--r);color:#fff;border-color:var(--r)}
.btn:disabled{opacity:.45}
.btn:active{transform:scale(.97)}
.big{font-size:18px;padding:14px 24px}
.inp{border:1px solid var(--bd);border-radius:12px;padding:10px 12px;font-size:16px;min-height:48px;background:#fff;color:var(--txt)}
.hero{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:16px}
.hero h1{margin:0;font-size:26px}.hero p{margin:4px 0 0;color:var(--mut)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px}
.kpi{background:var(--card);border-radius:16px;padding:14px 16px;box-shadow:0 1px 3px #0001;border-left:6px solid var(--pri2)}
.kpi .l{font-size:13px;color:var(--mut);font-weight:600}.kpi .v{font-size:28px;font-weight:800;margin-top:4px}.kpi .s{font-size:12px;color:var(--mut)}
.kpi.g{border-color:var(--g)}.kpi.g .v{color:var(--g)}.kpi.y{border-color:var(--y)}.kpi.y .v{color:#a16207}.kpi.r{border-color:var(--r)}.kpi.r .v{color:var(--r)}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.toolbar #q{flex:1;min-width:220px}
.selbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;background:#eff6ff;border:2px solid var(--pri2);border-radius:14px;padding:10px 14px;margin-bottom:14px;position:sticky;top:66px;z-index:15}
.selbar b{font-size:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:14px}
.card{background:var(--card);border-radius:16px;padding:16px;box-shadow:0 1px 3px #0001;margin-bottom:14px}
.grid .card{margin:0}
.card h3{margin:0 0 6px;font-size:18px}
.sess{cursor:pointer;border-top:5px solid var(--pri2);transition:.15s}.sess:active{transform:scale(.98)}
.sess.picked{outline:3px solid var(--pri);background:#eff6ff}
.pickmark{font-size:28px;line-height:1}
.line{font-size:30px;font-weight:800;color:var(--pri)}
.badge{background:#dbeafe;color:#1e40af;border-radius:999px;padding:4px 10px;font-size:13px;font-weight:700;white-space:nowrap}
.meta{color:var(--mut);font-size:14px;margin-top:6px}
.row{display:flex;align-items:center;gap:8px}.sb{justify-content:space-between}.wrap{flex-wrap:wrap}
.bar{height:12px;background:#e2e8f0;border-radius:99px;overflow:hidden;flex:1;min-width:60px}.bar i{display:block;height:100%;border-radius:99px}
i.g{background:var(--g)}i.y{background:var(--y)}i.r{background:var(--r)}
.t-g{color:var(--g)}.t-y{color:#a16207}.t-r{color:var(--r)}
.delbtn{border:1px solid #fecaca;background:#fef2f2;color:var(--r);border-radius:10px;min-height:44px;padding:0 12px;font-size:14px;font-weight:700;cursor:pointer}
.empty{text-align:center;color:var(--mut);padding:40px 16px}
.foot{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.shead{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.stitle{flex:1;min-width:200px}.stitle h2{margin:0;font-size:24px;display:flex;gap:8px;align-items:center}
.sact{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.tabs{display:flex;gap:8px;overflow-x:auto;position:sticky;top:60px;z-index:20;background:var(--bg);padding:10px 0}
.tabs button{border:none;background:#fff;border-radius:12px;padding:12px 18px;font-size:16px;font-weight:700;min-height:48px;white-space:nowrap;cursor:pointer;color:var(--mut)}
.tabs button.on{background:var(--pri);color:#fff}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:820px){.two{grid-template-columns:1fr}}
.brow{display:grid;grid-template-columns:minmax(120px,1.4fr) 2fr 120px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px dashed var(--bd);font-size:14px}
.brow .bv{text-align:right;font-weight:700}.brow small{color:var(--mut);font-weight:400}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 0 10px;flex:1}
.chip{white-space:nowrap;border:1px solid var(--bd);background:#fff;border-radius:999px;padding:10px 14px;font-size:14px;font-weight:600;cursor:pointer;min-height:44px}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px}.dot.g{background:var(--g)}.dot.y{background:var(--y)}.dot.r{background:var(--r)}.dot.n{background:#cbd5e1}
.bh{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.bmeta{display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:14px;color:var(--mut)}
.bmeta select{max-width:320px}
.bp{text-align:right;font-weight:800;font-size:22px}.bp small{display:block;font-size:12px;color:var(--mut);font-weight:500}
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--bd);border-radius:12px}
table.ck{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%}
.ck th,.ck td{border-bottom:1px solid var(--bd);border-right:1px solid var(--bd);padding:8px;font-size:14px;background:#fff;vertical-align:middle}
.ck thead th{background:#1e3a8a;color:#fff}
.ck .sn{position:sticky;left:0;z-index:2;width:48px;min-width:48px;text-align:center;font-weight:700;cursor:pointer}
.ck .st{position:sticky;left:48px;z-index:2;min-width:230px;max-width:290px;white-space:normal}
.ck th.op{min-width:96px;max-width:120px;font-size:12px;white-space:normal;cursor:pointer;text-align:center}
.ck td.cb{text-align:center;font-size:30px;cursor:pointer;user-select:none;color:#94a3b8;padding:2px;min-width:96px}
.ck td.cb.on{background:#dcfce7;color:var(--g)}
.ck tfoot td{font-weight:700;text-align:center;background:#f8fafc}
.pic{font-size:11px;font-weight:700;padding:3px 8px;border-radius:99px;background:#e2e8f0;white-space:nowrap}
.pic-pso{background:#fef3c7;color:#92400e}.pic-ie{background:#dbeafe;color:#1e40af}.pic-qc{background:#fce7f3;color:#9d174d}.pic-mekanik{background:#e0e7ff;color:#3730a3}
table.tbl{border-collapse:collapse;width:100%;font-size:14px}
.tbl th{background:#f8fafc;text-align:left;padding:10px;border-bottom:2px solid var(--bd);position:sticky;top:0}
.tbl td{padding:10px;border-bottom:1px solid var(--bd)}
.tbl .n{text-align:right}
.hchart{display:flex;align-items:flex-end;gap:8px;height:220px;padding-top:20px}
.hc{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:40px}
.hc i{width:100%;background:var(--pri2);border-radius:8px 8px 0 0}.hc b{font-size:12px}.hc small{font-size:10px;color:var(--mut);text-align:center;margin-top:4px}
.info{background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:12px;font-size:14px;color:#1e3a8a;margin-bottom:14px}
.legend{font-size:13px;color:var(--mut)}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(140px);background:#0f172a;color:#fff;padding:12px 18px;border-radius:12px;font-weight:600;transition:.3s;z-index:99;max-width:92vw;display:flex;gap:12px;align-items:center}
#toast.show{transform:translateX(-50%) translateY(0)}
.tbtn{background:#facc15;color:#0f172a;border:none;border-radius:10px;padding:10px 14px;font-weight:800;font-size:15px;min-height:44px;cursor:pointer}
</style>
</head>
<body>
<header class="top"><b>🏭 SOP Assessment • Line Production</b><span id="clock"></span></header>
<main id="app"></main>
<input type="file" id="file" accept=".xlsx,.xls,.xlsm,.csv" multiple hidden>
<input type="file" id="backupFile" accept=".json" hidden>
<div id="toast"></div>
<script>
/* ================= TEMPLATE SOP BAWAAN ================= */
const NEEDLE='Pergantian jarum : Washing 2x sehari, Normal dua hari 1x', RC='Random check (5 Pcs), Jika sudah ok lanjut.';
const HTL=[['Standard waktu 8 detik, Suhu 165%, Pressure Gap 2 Kg, Walmart : 3,5 kg','PSO'],['Cold feel : copot saat dingin dan Hot Feel : dicpot pada saat masih panas.','PSO'],['Bantalan harus bersih dan pattern harus terlihat dengan jelas','PSO'],['Waktu preparation harus sama dengan machine time','IE'],['Label selalu dipegang ditangan kiri','IE'],['Bantalan kiri dan kanan harus digunakan pada saat yang bersamaan.','IE'],['Bundle berisi 5 pcs garment','IE']];
const HEM=[[NEEDLE,'PSO'],['Pastikan tidak ada benang sisa di bagian atas','IE'],['Tidak ada rawedge.','IE'],['Tarik benang sisa dan potong dengan vacuum hanya sekali','IE'],[RC,'IE'],['Panel dimasukkan ke sepatu mesin, kemudian jahit sedikit, angkat panel dengan tangan kiri, tangan kanan mengatur lipatan panel lalu jahit sekali jahitan','IE'],['Pastikan pakai angin.','Mekanik'],['Standard RPM 4500','Mekanik'],['Jogi pastikan harus kuat.','Mekanik'],['Wajib harus ada Vacuum Trimer','Mekanik']];
const BUILTIN=[
{key:'tshirt',name:'T-Shirt',builtin:true,blocks:[
 {t:'Heat Seal Label - HTL',m:'Heat transfer main-label(HT main label)',i:HTL},
 {t:'Join Neck end to end - Single needle',m:'Join & tack neck binding end (Gabung neck binding end)',i:[['Ada pattern yang menempel di meja dekat sepatu mesin','PSO'],[NEEDLE,'PSO'],['Jahit dengan sambungan, tidak dipotong per pcs','IE'],['Jahit tidak perlu berhenti.','IE'],['Standard RPM 5000','Mekanik'],['Mengunakan mesin SNSC (cutter)','Mekanik']]},
 {t:'Join Neck Edge to Edge - Overlock',m:'',i:[['Standar RPM 5500','Mekanik'],[NEEDLE,'PSO'],['Penyimpanan setelah jahit di simpan di pergelangan tangan kiri','IE'],['Jahit tidak perlu berhenti.','IE'],['Tidak ada potong benang sisa','IE']]},
 {t:'Join Shoulder - Overlock',m:'Join shoulder w/ mobilon x2(Gabung bahu)',i:[[NEEDLE,'PSO'],['Pengambilan harus dengan 2 tangan','IE'],['Jahit dengan sambung untuk shoulder yang menggunakan mobilon','IE'],['Potong per pcs menggunakan vacuum untuk shoulder tanpa mobilon','IE'],[RC,'IE'],['Jahit tidak perlu berhenti.','IE'],['Tidak ada potong benang sisa','IE'],['Standard RPM 5500','Mekanik'],['Jogi pastikan harus kuat.','Mekanik']]},
 {t:'Attach Neck - Overlock',m:'Attach neck binding(Pasang neck binding)',i:[[NEEDLE,'PSO'],['Panel neck disimpan di pergelangan tangan kiri','IE'],['Stop point 1x untuk membenarkan tulang','IE'],['Tarik sisa benang lalu potong benang hanya 1x.','IE'],[RC,'IE'],['Potong jahitan wajib menggunakan Vacuum Trimer','IE'],['Standard RPM 5500','Mekanik'],['Menggunakan mesin obras roller.','Mekanik'],['Jogi pastikan harus kuat dibaut kiri dan kanan.','Mekanik']]},
 {t:'Attach Back Neck Tape - Single Needle, double needle & Overdeck',m:'',i:[[NEEDLE,'PSO'],['Maksimal stop point 2x (tergantung panjang jahitan) untuk mesin single needle & overdeck','IE'],['Jahit dengan sambung untuk penggunaan mesin overdeck','IE'],['Potong neck tape dengan gunting per pcs untuk mesin single & double needle','IE'],[RC,'IE'],['Standard RPM single & double needle 5000','Mekanik'],['Standard RPM overdeck 4500','Mekanik'],['Corong back neck tape pastikan harus kuat.','Mekanik'],['Menggunakan backtack auto diawal dan diakhir jahit','Mekanik'],['Menggunakan jogi mika/magnet','Mekanik']]},
 {t:'Topstitch Back Neck Tape - Single Needle',m:'',i:[[NEEDLE,'PSO'],['Maksimal stop point 3x (tergantung panjang jahitan)','IE'],['Potong sisa neck tape di kedua sisi sebelum jahit','IE'],[RC,'IE'],['Standard RPM 5000','Mekanik'],['Corong back neck tape pastikan harus kuat.','Mekanik'],['Menggunakan backtack auto diawal dan diakhir jahit','Mekanik'],['Menggunakan jogi mika','Mekanik']]},
 {t:'Attach Sleeve - Overlock',m:'Attach short sleeve x2(Pasang lengan pendek)',i:[[NEEDLE,'PSO'],['Diletakkan 5pcs perbundle','IE'],['Stop point 4x (2 stop point untuk masing-masing sisi)','IE'],['Tidak ada potong benang sisa','IE'],[RC,'IE'],['Standard RPM 5500','Mekanik'],['Ada meja tambahan untuk peletakkan panel tangan disebelah kanan mesin jahit','Mekanik'],['Jogi pastikan harus kuat dibaut kiri dan kanan.','Mekanik']]},
 {t:'Join Side Seam - Overlock',m:'Join short sleeve & side seam x2(Gabung  samping)',i:[[NEEDLE,'PSO'],['Hasil jahitan tidak boleh panjang pendek antara body depan dan belakang','QC'],['Stop point 5x untuk short sleeve & long sleeve (sebelum armpit, setelah armpit, dan sebelum pemasangan care label di sebelah kiri)','IE'],['Stop point 4x untuk short sleeve & long sleeve tanpa care label (sebelum armpit dan setelah armpit)','IE'],['Stop point 1x untuk tanktop (Sebelum care label)','IE'],['Sekali jahit untuk tanktop tanpa care label','IE'],['Diletakkan 5pcs perbundle','IE'],['Tidak ada potong benang sisa','IE'],['Pengambilan panel dengan 2 tangan langsung ke sleeve','IE'],['Penempatan diletakkan dekat dengan mesin jahit','IE'],[RC,'IE'],['Standard RPM 5500','Mekanik'],['Penambahan spiral untuk t-label','Mekanik'],['Jogi pastikan harus kuat dibaut kiri dan kanan.','Mekanik'],['Penambahan jogi koin untuk jenis fabric yang melintir','Mekanik']]},
 {t:'Hem Bottom - Overdeck',m:'Hem bottom(Hemming bawah)',i:HEM},
 {t:'Hem Sleeve - Overdeck',m:'Hem short sleeve x2(Hemming lengan pendek)',i:HEM}
]},
{key:'legging',name:'Legging',builtin:true,blocks:[
 {t:'Heat transfer main-label(HT main-label) - HTL',m:'Heat transfer main-label(HT main-label)',i:HTL},
 {t:'Join inseams x2(Gabung inseam) - Overlock',m:'Join inseams x2(Gabung inseam)',i:[[NEEDLE,'PSO'],[RC,'QC'],['Hasil jahitan tidak boleh panjang pendek antara body depan dan belakang','QC'],['Pengambilan langsung ke bagian yang akan dijahit','IE'],['Peletakan panel harus dekat dengan machine','IE'],['Jari dimasukan ke sela- sela panel','IE'],['Tidak perlu potong benang','IE'],['Size kecil tidak berhenti, size besar satu kali berhenti','IE'],['Standard RPM 5500','Mekanik'],['Menggunakan jogi lurus','Mekanik']]},
 {t:'Join outseam - Overlock',m:'',i:[[NEEDLE,'PSO'],[RC,'QC'],['Hasil jahitan tidak boleh panjang pendek antara body depan dan belakang','QC'],['Pengambilan langsung 2 panel sekaligus','IE'],['Jari dimasukan ke sela- sela panel','IE'],['Tidak perlu potong benang','IE'],['Peletakan panel harus dekat dengan machine','IE'],['Size kecil tidak berhenti, size besar satu kali berhenti','IE'],['Standard RPM 5500','Mekanik'],['Menggunakan jogi lurus','Mekanik']]},
 {t:'Join rises(Gabung rise) - Overlock',m:'Join rises(Gabung rise)',i:[[NEEDLE,'PSO'],[RC,'QC'],['Peletakan panel harus dekat dengan machine','IE'],['Pengambilan langsung ke bagian yang akan dijahit','IE'],['Dua kali berhenti : sebelum crotch dan setelah crotch','IE'],['Tidak perlu potong benang','IE'],['Menggunakan jogi melengkung','Mekanik'],['Standard RPM 5500','Mekanik']]},
 {t:'Tack center crotch(Bartek tengah crotch) - BT',m:'Tack center crotch(Bartek tengah crotch)',i:[[NEEDLE,'PSO'],[RC,'QC'],['Peletakan panel dipaha','IE'],['Pengambilan langsung ke bagian yang akan dijahit','IE'],['Penyimpanan di meja sebelah machine','IE']]},
 {t:'Attach eband to body + mark eband(Pasang elastik ke bodi) - Overlock',m:'Attach eband to body + mark eband(Pasang elastik ke bodi)',i:[[NEEDLE,'PSO'],['Penambahan pattern untuk elastik (check random)','QC'],[RC,'QC'],['Peletakan panel harus dekat dengan machine','IE'],['Peletakan elastic di pergelangan tangan','IE'],['Ditambah proses marking elastik (penambahan akrilik + kapur)','IE'],['Satu kali berhenti untuk geser seam/tulang (tidak ada outseam), dua kali berhenti (ada outseam)','IE'],['Gunting selalu di tangan kanan','IE'],['Perlu potong benang di akhir','IE'],['Menggunakan roller','Mekanik'],['Standard RPM 5500','Mekanik'],['Menggunakan mesin cylinder bed / kepala kecil','Mekanik']]},
 {t:'Topstitch waistband(Stik tutup waistband) - Overdeck',m:'Topstitch waistband(Stik tutup waistband)',i:[[NEEDLE,'PSO'],[RC,'QC'],['Peletakan panel harus dekat dengan machine','IE'],['Jahit tidak berhenti','IE'],['Gunting selalu di tangan kanan','IE'],['Gunting benang cukup sekali','IE'],['Menggunakan roller','Mekanik'],['Standard RPM 4500','Mekanik']]},
 {t:'Hem bottom x2(Hemming bawah) - Overdeck',m:'Hem bottom x2(Hemming bawah)',i:[[NEEDLE,'PSO'],[RC,'QC'],['Peletakan panel harus dekat dengan machine (dengan perbundle)','IE'],['Tidak berhenti (tidak ada outseam), satu kali berhenti (ada outseam)','IE'],['Gunting menggunakan vacuum trimmer','IE'],['Penyimpanan panel setelah jahit dilipat ke atas','IE'],['Gunting cukup sekali','IE'],['Tidak ada potong row edge','IE'],['Bundle maksimal 10 pcs dan selesaikan jahitan satu sisi terlebih dahulu','IE'],['Wajib harus ada vacuum trimmer','Mekanik'],['Pastikan ada angin','Mekanik'],['Standard RPM 4500','Mekanik'],['Menggunakan mesin cylinder bed / kepala kecil','Mekanik']]}
]}];

/* ================= STORAGE & UTIL ================= */
const LS_S='sopa_sessions_v1', LS_T='sopa_templates_v1';
const clone=o=>JSON.parse(JSON.stringify(o));
const load=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}};
let sessions=load(LS_S,[]), templates=load(LS_T,null)||clone(BUILTIN), trash=[];
function save(){try{localStorage.setItem(LS_S,JSON.stringify(sessions));localStorage.setItem(LS_T,JSON.stringify(templates));}catch(e){toast('⚠️ Penyimpanan penuh, lakukan Backup lalu hapus sesi lama')}}
let state={view:'home',sid:null,tab:'dash',q:'',fprod:'',sort:'new',tplOpen:null,showAll:false,selMode:false,sel:[]};
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm=s=>String(s??'').toLowerCase().replace(/[^a-z0-9]/g,'');
const num=v=>(v===''||v==null||isNaN(+v))?null:+v;
const fmtN=v=>v==null?'-':Number(v).toLocaleString('id-ID');
const pctTxt=x=>(x*100).toFixed(1)+'%';
const cls=x=>x>=.9?'g':x>=.6?'y':'r';
const cleanT=t=>String(t).replace(/\s*:\s*$/,'').trim();
const key=(bi,ii,n)=>bi+'|'+ii+'|'+n;
const pad=n=>String(n).padStart(2,'0');
const BLN=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
const fmtD=d=>{const m=String(d||'').match(/^(\d{4})-(\d{2})-(\d{2})$/);return m?`${+m[3]} ${BLN[+m[2]-1]} ${m[1]}`:(d||'-')};
function toYMD(v){
  if(v==null||v==='')return '';
  if(typeof v==='number'){const d=XLSX.SSF.parse_date_code(v);return d?`${d.y}-${pad(d.m)}-${pad(d.d)}`:''}
  const s=String(v).trim();let m=s.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);if(m)return `${m[1]}-${pad(m[2])}-${pad(m[3])}`;
  m=s.match(/(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})/);if(m)return `${m[3]}-${pad(m[2])}-${pad(m[1])}`;return s;
}
function toast(m,undo){
  const t=$('#toast');t.innerHTML=`<span>${esc(m)}</span>${undo?'<button class="tbtn" data-act="undo">↩️ Urungkan</button>':''}`;
  t.classList.add('show');clearTimeout(t._h);t._h=setTimeout(()=>{t.classList.remove('show');if(undo)trash=[]},undo?8000:3000);
}
function download(name,blob){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},500)}

/* ================= LOGIKA ================= */
const cur=()=>sessions.find(s=>s.id===state.sid);
const tplOf=s=>templates.find(t=>t.key===s.tpl)||{name:'(template tidak ada)',blocks:[]};
const procs=s=>[...new Set(s.ops.map(o=>o.process))];
function autoMatch(title,P){
  let t=norm(cleanT(title).replace(/\s*-\s*[A-Za-z ,&\/]+$/,''));if(t.length<5)return '';
  return P.find(p=>norm(p)===t)||P.find(p=>{const q=norm(p);return q.length>=5&&(q.includes(t)||t.includes(q))})||'';
}
function blockProc(s,bi,b,P){
  P=P||procs(s);
  if(s.map&&Object.prototype.hasOwnProperty.call(s.map,bi))return s.map[bi];
  if(b.m){const f=P.find(p=>norm(p)===norm(b.m));if(f)return f}
  return autoMatch(b.t,P);
}
function stats(s){
  const t=tplOf(s),P=procs(s);let total=0,done=0;const per={};
  const blocks=t.blocks.map((b,bi)=>{
    const p=blockProc(s,bi,b,P);
    const ops=p?[...new Set(s.ops.filter(o=>o.process===p).map(o=>o.name))]:[];
    let d=0;
    ops.forEach(n=>{per[n]=per[n]||{name:n,tot:0,done:0,proc:[]};per[n].tot+=b.i.length;per[n].proc.push(cleanT(b.t));
      b.i.forEach((_,ii)=>{if(s.checks[key(bi,ii,n)]){d++;per[n].done++}})});
    const tot=ops.length*b.i.length;total+=tot;done+=d;
    return {b,bi,p,ops,tot,done:d,pct:tot?d/tot:0};
  });
  const active=blocks.filter(x=>x.ops.length);
  const used=new Set(active.map(x=>x.p));
  return {blocks,active,used,total,done,pending:total-done,pct:total?done/total:0,
    opCount:Object.keys(per).length,procCount:active.length,per:Object.values(per)};
}
const sopOps=(s,st)=>s.ops.filter(o=>st.used.has(o.process));

